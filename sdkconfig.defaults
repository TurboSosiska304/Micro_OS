# Micro OS — default ESP-IDF configuration (ESP32-PICO-V3-02 / M5StickC Plus2)

CONFIG_IDF_TARGET="esp32"
CONFIG_IDF_TARGET_ESP32=y

# 8 MB flash (ESP32-PICO-V3-02 has 8 MB SPI flash)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# Custom partition table (see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 2 MB quad PSRAM (external RAM of the Plus2)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# CPU at full speed
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# Kernel-ish runtime settings
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_INT_WDT_TIMEOUT_S=10

# Logging: the kernel has its own log, the log of ESP-IDF only reports the
# problems, otherwise the output of the UART overflows during the boot
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Size over speed: the kernel is small, but memory matters on a 200 mAh device
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y

# UART console / flashing
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# The crash dump needs a partition of its own, the flash of the board is
# fully used by the application and the filesystem
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
