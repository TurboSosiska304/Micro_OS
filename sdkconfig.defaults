# Micro OS — default ESP-IDF configuration (ESP32-PICO-V3-02 / M5StickC Plus2)

CONFIG_IDF_TARGET="esp32"
CONFIG_IDF_TARGET_ESP32=y

# 8 MB flash (ESP32-PICO-V3-02 has 8 MB SPI flash)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# Custom partition table (see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 2 MB quad PSRAM (external RAM of the Plus2)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# CPU at full speed (the name of the symbol in IDF 5.x)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Kernel-ish runtime settings
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# The watchdog of the interrupts stops the board when the code keeps the
# interrupts off for too long - the name of the symbol carries the unit,
# and the value is in milliseconds (10 s, the largest the chip accepts).
CONFIG_ESP_INT_WDT_TIMEOUT_MS=10000

# Logging: the kernel has its own log, the log of ESP-IDF only reports the
# problems, otherwise the output of the UART overflows during the boot
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Size over speed: the kernel is small, but memory matters on a 200 mAh device
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y

# Reproducible builds: the date and the time of the compile leave the app
# description and the paths leave the binaries, so the same sources and the
# same SOURCE_DATE_EPOCH give the same .bin. The id of
# components/kernel/src/version.c is fixed by cmake/reproducible.cmake.
CONFIG_APP_REPRODUCIBLE_BUILD=y

# UART console / flashing
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# The crash dump needs a partition of its own, the flash of the board is
# fully used by the application and the filesystem
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y

# The windows of a program of the board (ADR 0018). A program is linked for
# two fixed addresses, and the top of the static DRAM region is one of them:
# the fixed size makes the heap begin at 0x3FFD0000 whatever the static
# sections of the kernel do, so the 8 KiB at 0x3FFCE000 are outside both. The
# port records the same two numbers in src/port_exec.c and the linker asserts
# that neither window is reached (exec_windows.ld).
CONFIG_ESP32_USE_FIXED_STATIC_RAM_SIZE=y
CONFIG_ESP32_FIXED_STATIC_RAM_SIZE=0x20000

# The optional features behind the compile-time flags (ADR 0010). The board
# keeps what it ships today: the HTTP client, the clock from NTP, the shell
# over the air and the WiFi station. MQTT and the page of the state are off:
# the board has no broker of its own, and "httpd" is a command a person
# starts. A release that wants MQTT turns it on here.
CONFIG_MICRO_OS_NET=y
CONFIG_MICRO_OS_NET_HTTP=y
# CONFIG_MICRO_OS_NET_HTTP_SERVER is not set
CONFIG_MICRO_OS_NET_NTP=y
# CONFIG_MICRO_OS_NET_MQTT is not set
CONFIG_MICRO_OS_TELNET=y
CONFIG_MICRO_OS_WIFI=y
